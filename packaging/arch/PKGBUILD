# Local PKGBUILD: builds the working tree this file lives in.
#   cd packaging/arch && makepkg -si

pkgname=harbour
pkgver=0.1.5
pkgrel=1
pkgdesc='A dock for KDE Plasma'
arch=('x86_64')
license=('GPL-3.0-or-later')
# The KWin effect is built against the exact KWin version: rebuild this package after KWin updates.
# Linked: Qt, wayland, layer-shell-qt, the KF6 libraries, kwin (the effect), kcmutils (settings page).
# At run time: plasma-workspace's task list QML module, kirigami for the settings page.
depends=('qt6-base' 'qt6-declarative' 'wayland' 'layer-shell-qt' 'kwin' 'plasma-workspace' 'kconfig'
         'kcoreaddons' 'kglobalaccel' 'kio' 'kservice' 'kcmutils' 'kirigami')
makedepends=('cmake' 'extra-cmake-modules' 'ninja' 'plasma-wayland-protocols' 'vulkan-headers')
source=()

_srcroot="$(realpath "$startdir/../..")"

build() {
  cmake -S "$_srcroot" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_srcroot/packaging/arch/harbour.hook" "$pkgdir/usr/share/libalpm/hooks/harbour.hook"
  install -Dm644 "$_srcroot/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
